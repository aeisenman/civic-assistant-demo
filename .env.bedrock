# AWS profile: Bedrock behind a LiteLLM gateway that speaks the OpenAI protocol.
# This is the demo configuration. COMPOSE_PROFILES below means a plain
#   cp .env.bedrock .env && docker compose up -d --build
# starts the gateway too; `docker compose --profile aws ...` is no longer needed.
# The API code does not change: only the model names and the base URL do.
# EMBED_DIM differs from the Ollama profile, and the vector column width is set
# at migration time, so switching to this profile needs a fresh DB
# (bash scripts/reset_demo.sh).
# ---------------------------------------------------------------------------
# DEMO CREDENTIALS, COMMITTED ON PURPOSE. Everything below is public: it is in
# git, so treat STAFF_PASSWORD, S3_SECRET_KEY, LLM_API_KEY, EMBED_API_KEY,
# SESSION_SECRET and LITELLM_MASTER_KEY as already leaked. api/app/config.py refuses to start with
# ENVIRONMENT=prod while any of them is still set to a value from this file —
# deploy/aws/up.sh generates real ones and writes ENVIRONMENT=prod itself.
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=aws

# dev is the default; it is what allows the placeholder secrets below.
ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://civic:civic@db:5432/civic

S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=civic
S3_SECRET_KEY=civicsecret
S3_BUCKET=civic-docs

# The gateway's own bearer token. docker-compose.yml passes it through as
# LITELLM_MASTER_KEY and deploy/aws/litellm.yaml reads it from the
# environment, so these three must agree; on EC2 up.sh regenerates all of
# them together.
LITELLM_MASTER_KEY=sk-litellm-demo

LLM_BASE_URL=http://litellm:4000/v1
LLM_API_KEY=sk-litellm-demo
# These are LiteLLM aliases; the Bedrock model ids live in deploy/aws/litellm.yaml.
# small=Claude Haiku 4.5, smart=Claude Sonnet 4.6, escalate=Claude Opus 4.6,
# extract=Amazon Nova Lite (300k context, cheapest usable long window).
LLM_MODEL_SMALL=small
LLM_MODEL_SMART=smart
LLM_MODEL_ESCALATE=escalate
LLM_MODEL_EXTRACT=extract

EMBED_BASE_URL=http://litellm:4000/v1
EMBED_API_KEY=sk-litellm-demo
EMBED_MODEL=embed
# amazon.titan-embed-text-v2:0 returns 1024 dims. Needs a fresh DB to switch.
EMBED_DIM=1024

# Live City of San Diego data (M8). false makes every ArcGIS/geocoder/RSS call
# a no-op and the tools fall back to seed data, so the demo works offline.
LIVE_DATA_ENABLED=true
LIVE_HTTP_TIMEOUT_S=4
# search_city_website provider: "brave" (needs SEARCH_API_KEY) or "none". With
# "none" the tool honestly reports it is not configured.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

SEED_ON_STARTUP=true
INGEST_KB_ON_STARTUP=true
# Bedrock us-west-2 on-demand list prices, USD per 1M tokens, keyed by the alias
# the trace records (the app prices by the name it sends, not the Bedrock id).
# Titan embeddings are input-only, so output is 0.
# Nova Lite ($0.06 / $0.24) confirmed against `aws pricing get-products
# --service-code AmazonBedrock` (USW2-NovaLite-input-tokens / -output-tokens,
# publication date 2026-09-01). The Anthropic and Titan models are not published
# under that API's `model` attribute, so those four numbers are list prices as of
# 2026-09, verify.
LLM_PRICES_JSON={"small":{"input_per_1m":1.00,"output_per_1m":5.00},"smart":{"input_per_1m":3.00,"output_per_1m":15.00},"escalate":{"input_per_1m":5.00,"output_per_1m":25.00},"extract":{"input_per_1m":0.06,"output_per_1m":0.24},"embed":{"input_per_1m":0.02,"output_per_1m":0.0}}
# LiteLLM alias -> the model that actually answers, so /health and the trace UI
# can show "smart · claude-sonnet-4-6" instead of the bare alias.
LLM_PROVIDER_MODELS_JSON={"small":"claude-haiku-4-5","extract":"amazon-nova-lite","smart":"claude-sonnet-4-6","escalate":"claude-opus-4-6","embed":"titan-embed-v2"}

# Staff login (M11). The seed loader upserts this one back-office account at
# startup and re-hashes the password, so changing it here and restarting is
# enough. The staff queue, the traces page and certificate downloads need it.
STAFF_USERNAME=staff
STAFF_PASSWORD=CHANGE_ME
STAFF_DISPLAY_NAME=City Staff
# Signs the resident_session cookie (M20). Committed, therefore public, and on
# the placeholder denylist: ENVIRONMENT=prod refuses to start with this value.
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# Browser origin(s) allowed to send the session cookie. A CORS wildcard cannot
# carry credentials, so these are explicit: :3001 is the compose web container,
# :3002 the dev server Playwright starts.
WEB_ORIGIN=http://localhost:3001,http://localhost:3002
# Left commented out on purpose: unset means "derive the cookie's Secure flag
# from the request scheme", while an empty COOKIE_SECURE= is a bool parse
# error. Uncomment it behind a TLS-terminating proxy, where the app only
# ever sees http and would otherwise send the session cookie unprotected.
# COOKIE_SECURE=true
