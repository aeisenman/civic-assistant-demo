<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.municipality.demo-up</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/path/to/civic-assistant-demo/scripts/demo_up.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Month</key><integer>9</integer>
    <key>Day</key><integer>8</integer>
    <key>Hour</key><integer>17</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key><string>/path/to/civic-assistant-demo/data/demo_up.launchd.log</string>
  <key>StandardErrorPath</key><string>/path/to/civic-assistant-demo/data/demo_up.launchd.log</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
