# Template. Copy one of .env.ollama / .env.openai / .env.bedrock to .env instead;
# .env is gitignored. Every variable below is read by api/app/config.py.
# dev | prod. prod refuses every CHANGEME below (api/app/config.py).
ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://civic:civic@db:5432/civic

S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=civic
S3_SECRET_KEY=CHANGEME
S3_BUCKET=civic-docs

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_API_KEY=CHANGEME
LLM_MODEL_SMALL=qwen2.5:3b
LLM_MODEL_SMART=qwen2.5:7b
LLM_MODEL_ESCALATE=qwen2.5:7b
# 32k-context variant built by scripts/setup_ollama.sh (Ollama defaults to 4k).
LLM_MODEL_EXTRACT=qwen2.5:7b-32k

EMBED_BASE_URL=http://host.docker.internal:11434/v1
EMBED_API_KEY=CHANGEME
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768

# Live City of San Diego data (M8). false makes every ArcGIS/geocoder/RSS call
# a no-op and the tools fall back to seed data, so the demo works offline.
LIVE_DATA_ENABLED=true
LIVE_HTTP_TIMEOUT_S=4
# search_city_website provider: "brave" (needs SEARCH_API_KEY) or "none". With
# "none" the tool honestly reports it is not configured.
SEARCH_PROVIDER=none
SEARCH_API_KEY=

SEED_ON_STARTUP=true
INGEST_KB_ON_STARTUP=true
# model -> {input_per_1m, output_per_1m} in USD. Empty = every call costs $0.
LLM_PRICES_JSON={}

# Staff login (M11). The seed loader upserts this one back-office account at
# startup and re-hashes the password, so changing it here and restarting is
# enough. The staff queue, the traces page and certificate downloads need it.
STAFF_USERNAME=staff
# Generate one: openssl rand -base64 24
STAFF_PASSWORD=CHANGEME
STAFF_DISPLAY_NAME=City Staff
# Signs the resident_session cookie, which is what stops a leaked session id
# from replaying someone else's conversation (M20). Nothing is stored
# server-side, so changing this simply starts everyone a new conversation.
# Generate one: openssl rand -base64 24
SESSION_SECRET=CHANGEME
# Browser origin(s) allowed to send the session cookie. A CORS wildcard cannot
# carry credentials, so these are explicit: :3001 is the compose web container,
# :3002 the dev server Playwright starts.
WEB_ORIGIN=http://localhost:3001,http://localhost:3002
# Left commented out on purpose: unset means "derive the cookie's Secure flag
# from the request scheme", while an empty COOKIE_SECURE= is a bool parse
# error. Uncomment it behind a TLS-terminating proxy, where the app only
# ever sees http and would otherwise send the session cookie unprotected.
# COOKIE_SECURE=true

# Read by docker-compose.yml's litellm service (profile: aws). Required even
# on the Ollama profile, because compose interpolates the whole file.
LITELLM_MASTER_KEY=CHANGEME
