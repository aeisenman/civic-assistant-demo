# CI profile for .github/workflows/compose-smoke.yml. Committed on purpose:
# every value here is a throwaway that only ever exists inside a GitHub runner.
# It is Ollama-shaped (plain OpenAI protocol, no gateway, no AWS profile), but
# the model endpoint is scripts/ci/stub_openai.py, so nothing is billed.
# The workflow copies this to .env because compose declares `env_file: .env`.
ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://civic:civic@db:5432/civic

S3_ENDPOINT=http://seaweedfs:8333
S3_ACCESS_KEY=civic
S3_SECRET_KEY=civicsecret
S3_BUCKET=civic-docs

# The stub server runs on the runner host; the api container reaches it through
# the host-gateway alias compose already declares for the Ollama profile.
LLM_BASE_URL=http://host.docker.internal:4010/v1
LLM_API_KEY=ci-stub
LLM_MODEL_SMALL=stub-small
LLM_MODEL_SMART=stub-smart
LLM_MODEL_ESCALATE=stub-smart
LLM_MODEL_EXTRACT=stub-smart

EMBED_BASE_URL=http://host.docker.internal:4010/v1
EMBED_API_KEY=ci-stub
EMBED_MODEL=stub-embed
# Must match migration 002's vector column width and the stub's vector length.
EMBED_DIM=768

# No outbound calls to sandiego.gov from a CI runner.
LIVE_DATA_ENABLED=false
LIVE_HTTP_TIMEOUT_S=4
SEARCH_PROVIDER=none
SEARCH_API_KEY=

# Seeding is the point of the smoke check (it proves migrations + seed run);
# ingesting the KB is 120 embedding calls of no value against a stub vector.
SEED_ON_STARTUP=true
INGEST_KB_ON_STARTUP=false
LLM_PRICES_JSON={}

STAFF_USERNAME=staff
STAFF_PASSWORD=ci-not-a-real-password
STAFF_DISPLAY_NAME=CI Staff
# Signs the resident_session cookie (M20). Any fixed value works in CI; the
# smoke job only needs the same one for the life of a run.
SESSION_SECRET=ci-not-a-real-session-secret
WEB_ORIGIN=http://localhost:3001

# Read by docker-compose.yml for the web build arg; the smoke job builds the web
# image but only starts db, seaweedfs and api.
NEXT_PUBLIC_API_URL=http://localhost:8080

# The litellm service is under the `aws` profile, so CI never starts it —
# but compose interpolates `${LITELLM_MASTER_KEY:?}` before it filters on
# profiles, so `docker compose config` needs a value here regardless.
LITELLM_MASTER_KEY=ci-unused
